{
  "name": "amira-monorepo",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "amira": "bun packages/cli/src/main.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "test": "bun test --parallel=3 --timings=scripts/test-timings.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "architecture:check": "bun scripts/architecture-check.ts",
    "check": "bun run architecture:check && bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/bun": "^1.4.2",
    "@types/pngjs": "^6.0.5",
    "@xterm/headless": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
