<Window x:Class="Amira.Client.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Amira.Client.WinUI" xmlns:domain="using:Amira.Domain" xmlns:contracts="using:Amira.Contracts">
  <Grid x:Name="Root" RequestedTheme="Dark" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Side" Color="#141619" />
            <SolidColorBrush x:Key="Surface" Color="#1A1C20" />
            <SolidColorBrush x:Key="Raised" Color="#202329" />
            <SolidColorBrush x:Key="User" Color="#1D2B43" />
            <SolidColorBrush x:Key="Select" Color="#182A45" />
            <SolidColorBrush x:Key="Line" Color="#363A40" />
            <SolidColorBrush x:Key="Accent" Color="#4D91FF" />
            <SolidColorBrush x:Key="Avatar" Color="#2B2E34" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Side" Color="#F9FAFC" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Raised" Color="#F0F3F8" />
            <SolidColorBrush x:Key="User" Color="#E6F0FF" />
            <SolidColorBrush x:Key="Select" Color="#E6F0FF" />
            <SolidColorBrush x:Key="Line" Color="#D4D9E1" />
            <SolidColorBrush x:Key="Accent" Color="#286FD9" />
            <SolidColorBrush x:Key="Avatar" Color="#E4E7ED" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <local:NullToVisibilityConverter x:Key="NullVisibility" />
        <local:EnumValueToVisibilityConverter x:Key="EnumVisibility" />
        <local:UserNoticeSeverityConverter x:Key="NoticeSeverity" />
        <local:UserNoticeLiveSettingConverter x:Key="NoticeLiveSetting" />
        <local:LocalTimeConverter x:Key="LocalTime" />
        <local:TurnActionVisibilityConverter x:Key="ActionVisibility" />
        <local:TurnActionAreaVisibilityConverter x:Key="ActionAreaVisibility" />
        <local:TurnIdShortConverter x:Key="TurnIdShort" />
        <local:TurnStatusTextConverter x:Key="TurnStatusText" />
        <local:TurnStatusBrushConverter x:Key="TurnStatusBrush" />
        <local:TurnStatusIconVisibilityConverter x:Key="TurnStatusIconVisibility" />
        <local:TurnActivityTimeLabelConverter x:Key="ActivityTimeLabel" />
        <local:TurnActivityTimeConverter x:Key="ActivityTime" />
        <local:ProviderProtocolTextConverter x:Key="ProviderProtocolText" />
        <local:TurnFailureDetailConverter x:Key="FailureDetailText" />
        <local:TurnUsageTotalConverter x:Key="UsageTotal" />
        <local:TurnUsageTokenConverter x:Key="UsageToken" />
        <local:TurnDurationConverter x:Key="TurnDuration" />
        <Style x:Key="Quiet" TargetType="Button">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
          <Setter Property="Background" Value="{ThemeResource Raised}" />
          <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Padding" Value="14,8" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="BotListItem" TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="MinHeight" Value="76" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <primitives:ListViewItemPresenter
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                  ContentTransitions="{TemplateBinding ContentTransitions}"
                  Padding="{TemplateBinding Padding}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  PointerOverBackground="{ThemeResource Raised}"
                  PointerOverBorderBrush="{ThemeResource Line}"
                  SelectedBackground="{ThemeResource Select}"
                  SelectedPointerOverBackground="{ThemeResource Select}"
                  SelectedPressedBackground="{ThemeResource Select}"
                  SelectedBorderBrush="{ThemeResource Accent}"
                  SelectedPointerOverBorderBrush="{ThemeResource Accent}"
                  SelectedPressedBorderBrush="{ThemeResource Accent}"
                  SelectedInnerBorderBrush="{ThemeResource Accent}"
                  SelectedBorderThickness="1"
                  SelectionIndicatorVisualEnabled="False"
                  SelectionCheckMarkVisualEnabled="False" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <DataTemplate x:Key="Human" x:DataType="domain:ChatMessage">
          <Grid HorizontalAlignment="Right" MaxWidth="548" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Right">
              <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}" HorizontalAlignment="Right" FontSize="12" Opacity=".65" Margin="0,0,2,6" />
              <Border Background="{ThemeResource User}" CornerRadius="12" Padding="18,14">
                <TextBlock Text="{Binding Revision.Content}" TextWrapping="Wrap" LineHeight="26" FontSize="17" />
              </Border>
            </StackPanel>
            <Border Grid.Column="1" Width="50" Height="50" CornerRadius="25" Background="{ThemeResource Avatar}" Margin="12,0,0,0" VerticalAlignment="Top">
              <TextBlock Text="You" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Bot" x:DataType="domain:ChatMessage">
          <Grid HorizontalAlignment="Left" MaxWidth="650" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="66" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="25" Background="{ThemeResource Raised}" VerticalAlignment="Top">
              <Image Source="ms-appx:///Assets/bot-avatar-gem.png" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{Binding DataContext.SelectedBot.Profile.Name, ElementName=Root, TargetNullValue=Bot}" FontWeight="SemiBold" />
              <local:MarkdownView Markdown="{Binding Revision.Content}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LongBot" x:DataType="domain:ChatMessage">
          <Grid HorizontalAlignment="Left" MaxWidth="650" Margin="0,16,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="25" Background="{ThemeResource Raised}" VerticalAlignment="Top"><Image Source="ms-appx:///Assets/bot-avatar-gem.png" Stretch="Uniform" /></Border>
            <StackPanel Grid.Column="1" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding DataContext.SelectedBot.Profile.Name, ElementName=Root, TargetNullValue=Bot}" FontWeight="SemiBold" /><TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}" FontSize="12" Opacity=".65" /></StackPanel>
              <Border Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,14"><local:MarkdownView Markdown="{Binding Revision.Content}" /></Border>
            </StackPanel>
          </Grid>
        </DataTemplate>
        <local:ChatMessageTemplateSelector x:Key="Messages" HumanTemplate="{StaticResource Human}" BotTemplate="{StaticResource Bot}" LongBotTemplate="{StaticResource LongBot}" />
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAcceleratorInvoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="337" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="375" />
    </Grid.ColumnDefinitions>
    <Grid x:Name="AppTitleBar" Grid.ColumnSpan="3" Height="48" Padding="14,0,160,0">
      <TextBlock Text="Amira" FontSize="14" VerticalAlignment="Center" />
    </Grid>
    <InfoBar x:Name="UserNoticeBar"
             Grid.Row="1"
             Grid.ColumnSpan="3"
             Margin="12,8"
             Message="{Binding Notice.Message}"
             Severity="{Binding Notice.Severity, Converter={StaticResource NoticeSeverity}}"
             IsOpen="{Binding HasNotice}"
             IsClosable="True"
             Closed="UserNoticeClosed"
             AutomationProperties.Name="{Binding Notice.Message}"
             AutomationProperties.LiveSetting="{Binding Notice.Severity, Converter={StaticResource NoticeLiveSetting}}" />
    <Border x:Name="SidebarPane" Grid.Row="2" Grid.Column="0" Background="{ThemeResource Side}" BorderBrush="{ThemeResource Line}" BorderThickness="0,0,1,0">
      <Grid Padding="16,16,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Quiet}" Click="ToggleSidebarClick" AutomationProperties.Name="Toggle navigation">
            <SymbolIcon Symbol="GlobalNavigationButton" />
          </Button>
          <TextBlock x:Name="BrandText" Grid.Column="1" Text="Amira" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="SidebarDetails" Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button Height="46" HorizontalAlignment="Stretch" Padding="12,0" Click="WorkspaceClick" BorderBrush="{ThemeResource Line}" AutomationProperties.Name="Current workspace">
            <Button.Background>
              <SolidColorBrush Color="Transparent" />
            </Button.Background>
            <Button.BorderThickness>1</Button.BorderThickness>
            <Button.CornerRadius>10</Button.CornerRadius>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Folder" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Work" FontSize="16" />
                <TextBlock Text="Local workspace" FontSize="12" Opacity=".62" />
              </StackPanel>
            </Grid>
          </Button>
          <Grid Grid.Row="1" Height="47" Margin="0,16,0,28">
            <AutoSuggestBox x:Name="SearchBotsBox" x:Uid="BotSearchInput" PlaceholderText="Search bots" TextChanged="SearchBotsTextChanged" AutomationProperties.Name="Search bots">
              <AutoSuggestBox.QueryIcon>
                <SymbolIcon Symbol="Find" />
              </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <TextBlock Text="Ctrl+K" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,38,0" FontSize="12" Opacity=".58" IsHitTestVisible="False" />
          </Grid>
          <Grid Grid.Row="2" Margin="8,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bots" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource Quiet}" Click="NewBotClick" IsEnabled="{Binding CanCreateBot}" ToolTipService.ToolTip="Create Bot" AutomationProperties.Name="Create Bot">
              <SymbolIcon Symbol="Add" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Quiet}" Click="ManageBotsClick" ToolTipService.ToolTip="Manage Bots" AutomationProperties.Name="Manage Bots">
              <SymbolIcon Symbol="Setting" />
            </Button>
          </Grid>
          <Grid Grid.Row="3">
            <ListView x:Name="BotsList"
                      ItemsSource="{Binding VisibleBots}"
                      SelectedItem="{Binding SelectedBot, Mode=OneWay}"
                      SelectionChanged="BotsSelectionChanged"
                      ItemContainerStyle="{StaticResource BotListItem}"
                      Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=Content}"
                      AutomationProperties.Name="Bots">
              <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemSelectedBackgroundThemeBrush" Color="#182F51" />
                <SolidColorBrush x:Key="ListViewItemSelectedPointerOverBackgroundThemeBrush" Color="#20406D" />
                <SolidColorBrush x:Key="ListViewItemSelectedForegroundThemeBrush" Color="#FFFFFF" />
              </ListView.Resources>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:Bot">
                  <Grid MinHeight="76" Padding="12,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{ThemeResource Raised}">
                      <Image Source="ms-appx:///Assets/bot-avatar-gem.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Profile.Name}" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="Direct chat" FontSize="13" Opacity=".7" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Uid="LoadingBotsState" Width="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,28,0,0"
                        Spacing="10"
                        Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=Loading}"
                        AutomationProperties.Name="Loading Bots">
              <ProgressRing Width="24" Height="24" IsActive="True" HorizontalAlignment="Center" />
              <TextBlock x:Uid="LoadingBotsText" Text="Loading Bots…" HorizontalAlignment="Center" Opacity=".68" />
            </StackPanel>
            <StackPanel x:Uid="NoEnabledConnectionsState" Width="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,28,0,0"
                        Spacing="10"
                        Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=NoEnabledConnections}"
                        AutomationProperties.Name="No enabled connections">
              <TextBlock x:Uid="NoEnabledConnectionsHeading" Text="No connections" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Uid="NoEnabledConnectionsDescription" Text="Add an enabled connection to create a Bot." TextWrapping="Wrap" TextAlignment="Center" Opacity=".66" />
              <Button x:Uid="ManageConnectionsEmptyAction" Content="Manage connections" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Click="ConnectionsClick" AutomationProperties.Name="Manage connections" />
            </StackPanel>
            <StackPanel x:Uid="NoBotsState" Width="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,28,0,0"
                        Spacing="10"
                        Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=NoBots}"
                        AutomationProperties.Name="No Bots yet">
              <TextBlock x:Uid="NoBotsHeading" Text="No Bots yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Uid="NoBotsDescription" Text="Create a Bot to start a Direct chat." TextWrapping="Wrap" TextAlignment="Center" Opacity=".66" />
              <Button x:Uid="CreateBotEmptyAction" Content="Create Bot" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Click="NewBotClick" IsEnabled="{Binding CanCreateBot}" AutomationProperties.Name="Create Bot" />
            </StackPanel>
            <StackPanel x:Uid="ArchivedOnlyState" Width="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,28,0,0"
                        Spacing="10"
                        Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=ArchivedOnly}"
                        AutomationProperties.Name="All Bots are archived">
              <TextBlock x:Uid="ArchivedOnlyHeading" Text="All Bots are archived" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Uid="ArchivedOnlyDescription" Text="Restore a Bot to return it to the sidebar." TextWrapping="Wrap" TextAlignment="Center" Opacity=".66" />
              <Button x:Uid="ManageArchivedBotsAction" Content="Manage Bots" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Click="ManageBotsClick" AutomationProperties.Name="Manage Bots" />
            </StackPanel>
            <StackPanel x:Uid="SearchNoResultsState" Width="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,28,0,0"
                        Spacing="10"
                        Visibility="{Binding NavigationState, Converter={StaticResource EnumVisibility}, ConverterParameter=SearchNoResults}"
                        AutomationProperties.Name="No Bots match your search">
              <TextBlock x:Uid="NoBotSearchResultsHeading" Text="No Bots match your search" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
              <Button x:Uid="ClearBotSearchAction" Content="Clear search" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Click="ClearBotSearchClick" AutomationProperties.Name="Clear Bot search" />
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="SidebarFooter" Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ConnectionsButton" Style="{StaticResource Quiet}" Click="ConnectionsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Manage provider connections" AutomationProperties.Name="Manage provider connections">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Connections" />
              <TextBlock Text="{Binding ConnectionSummary}" Opacity=".7" />
            </StackPanel>
          </Button>
          <Button x:Name="ThemeButton" Grid.Column="1" Width="44" Height="44" Style="{StaticResource Quiet}" Click="ToggleThemeClick" AutomationProperties.Name="Switch to light appearance" ToolTipService.ToolTip="Switch to light appearance">
            <FontIcon x:Name="ThemeIcon" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE706;" />
          </Button>
          <Button x:Name="SettingsButton"
                  x:Uid="OpenSettingsButton"
                  Grid.Column="2"
                  Width="44"
                  Height="44"
                  Style="{StaticResource Quiet}"
                  Click="SettingsClick"
                  AutomationProperties.Name="Open settings"
                  ToolTipService.ToolTip="Settings">
            <SymbolIcon Symbol="Setting" />
          </Button>
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="ConversationPane" Grid.Row="2" Grid.Column="1" MinWidth="450">
      <Grid.RowDefinitions>
        <RowDefinition Height="87" />
        <RowDefinition Height="*" />
      <RowDefinition Height="172" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{ThemeResource Line}" BorderThickness="0,0,0,1" Padding="22,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource Raised}">
            <Image Source="ms-appx:///Assets/bot-avatar-gem.png" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedBot.Profile.Name, TargetNullValue=Choose a Bot}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Direct chat" FontSize="16" Opacity=".7" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Quiet}" Click="BotDetailsClick" AutomationProperties.Name="Bot details">
            <SymbolIcon Symbol="More" />
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
      <ListView x:Name="ConversationList" Padding="24,12" ItemsSource="{Binding Timeline}" ItemTemplateSelector="{StaticResource Messages}" SelectionMode="None" IsItemClickEnabled="False" Loaded="ConversationListLoaded" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.ZoomMode="Disabled" Visibility="{Binding ConversationState, Converter={StaticResource EnumVisibility}, ConverterParameter=Content}" AutomationProperties.Name="Conversation">
        <ListView.ItemsPanel>
          <ItemsPanelTemplate><ItemsStackPanel /></ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.Footer>
          <ItemsControl x:Name="StreamingTurnsItems" ItemsSource="{Binding StreamingTurns}" Margin="90,0,24,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:RuntimeTurnProjection">
                <Border Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                  <StackPanel Spacing="6">
                    <local:ResponseLoadingIndicator AccentBrush="{ThemeResource Accent}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="24" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ListView.Footer>
      </ListView>
        <StackPanel x:Uid="LoadingConversationState" Width="310"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{Binding ConversationState, Converter={StaticResource EnumVisibility}, ConverterParameter=Loading}"
                    AutomationProperties.Name="Loading Direct chat">
          <ProgressRing Width="28" Height="28" IsActive="True" HorizontalAlignment="Center" />
          <TextBlock x:Uid="LoadingConversationText" Text="Loading Direct chat…" HorizontalAlignment="Center" Opacity=".68" />
        </StackPanel>
        <StackPanel x:Uid="NoSelectionState" Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding ConversationState, Converter={StaticResource EnumVisibility}, ConverterParameter=NoSelection}"
                    AutomationProperties.Name="Choose a Bot">
          <TextBlock x:Uid="NoSelectionHeading" Text="Choose a Bot" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Uid="SelectBotEmptyDescription" Text="Select an active Bot from the sidebar to open its Direct chat." TextWrapping="Wrap" TextAlignment="Center" Opacity=".66" />
        </StackPanel>
        <StackPanel x:Uid="EmptyChatState" Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding ConversationState, Converter={StaticResource EnumVisibility}, ConverterParameter=EmptyChat}"
                    AutomationProperties.Name="No messages yet">
          <TextBlock x:Uid="EmptyChatHeading" Text="No messages yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Uid="NoMessagesEmptyDescription" Text="Send a message to start this Direct chat." TextWrapping="Wrap" TextAlignment="Center" Opacity=".66" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Margin="12,10,12,16" Padding="16,12" Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Accent}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox x:Name="MessageBox" Text="{Binding MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" PlaceholderText="Type your message…" KeyDown="MessageKeyDown" AutomationProperties.Name="Message" />
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Quiet}" IsEnabled="False" ToolTipService.ToolTip="Attachments are not available yet">
              <SymbolIcon Symbol="Attach" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource Quiet}" IsEnabled="False" ToolTipService.ToolTip="Code snippets are not available yet">
              <SymbolIcon Symbol="Edit" />
            </Button>
            <TextBlock Grid.Column="3" Text="Enter to send · Shift+Enter for a new line" FontSize="12" Opacity=".65" VerticalAlignment="Center" />
            <Button Grid.Column="4" MinWidth="99" Height="56" Style="{StaticResource Action}" Background="{ThemeResource Accent}" Foreground="White" Content="Send" Click="SendClick" IsEnabled="{Binding CanSend}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="ActivityPane" Grid.Row="2" Grid.Column="2" Background="{ThemeResource Side}" BorderBrush="{ThemeResource Line}" BorderThickness="1,0,0,0">
      <Grid Padding="16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    MinWidth="150"
                    MaxWidth="180"
                    Height="36"
                    HorizontalAlignment="Right"
                    ItemsSource="{Binding Turns}"
                    SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                    PlaceholderText="No turns"
                    AutomationProperties.Name="Selected activity turn">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="contracts:TurnView">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding TurnId, Converter={StaticResource TurnIdShort}}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Converter={StaticResource TurnStatusText}}" Opacity=".7" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid Grid.Row="1">
          <StackPanel Width="250" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="9" Visibility="{Binding CurrentActivity, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}">
            <SymbolIcon Symbol="Clock" HorizontalAlignment="Center" Opacity=".55" />
            <TextBlock Text="No activity yet" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity=".8" />
            <TextBlock Text="The latest bot turn will appear here." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Opacity=".6" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled" Visibility="{Binding CurrentActivity, Converter={StaticResource NullVisibility}}">
            <ContentControl Content="{Binding CurrentActivity}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
              <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="contracts:TurnView">
                <StackPanel HorizontalAlignment="Stretch">
                  <Grid Height="64">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource Raised}">
                        <Image Source="ms-appx:///Assets/bot-avatar-gem.png" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DataContext.SelectedBot.Profile.Name, ElementName=Root, TargetNullValue=Bot}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding QueuedAt, Converter={StaticResource LocalTime}}" FontSize="13" Opacity=".65" />
                      </StackPanel>
                      <Border Grid.Column="2" Height="34" Padding="11,0" CornerRadius="17" BorderThickness="1" BorderBrush="{Binding Converter={StaticResource TurnStatusBrush}}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <Grid Width="14" Height="14">
                            <SymbolIcon Symbol="Clock" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=Queued}" />
                            <SymbolIcon Symbol="Play" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=Running}" />
                            <SymbolIcon Symbol="Accept" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=Completed}" />
                            <SymbolIcon Symbol="Important" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=Failed}" />
                            <SymbolIcon Symbol="Cancel" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=Cancelled}" />
                            <SymbolIcon Symbol="Cancel" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" Visibility="{Binding Converter={StaticResource TurnStatusIconVisibility}, ConverterParameter=StopRequested}" />
                          </Grid>
                          <TextBlock Text="{Binding Converter={StaticResource TurnStatusText}}" Foreground="{Binding Converter={StaticResource TurnStatusBrush}}" FontSize="13" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                  <Border Height="1" Background="{ThemeResource Line}" />
                  <TextBlock Text="CURRENT TURN" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Opacity=".62" Margin="0,16,0,9" />
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Turn" FontSize="14" Opacity=".68" />
                    <TextBlock Grid.Column="1" Text="{Binding TurnId, Converter={StaticResource TurnIdShort}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding TurnId}" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Model" FontSize="14" Opacity=".68" />
                    <TextBlock Grid.Column="1" Text="{Binding Model}" TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Model}" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ActivityProviderLabel" Text="Provider" FontSize="14" Opacity=".68" AutomationProperties.Name="Provider protocol" />
                    <TextBlock Grid.Column="1" Text="{Binding Protocol, Converter={StaticResource ProviderProtocolText}}" TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Protocol, Converter={StaticResource ProviderProtocolText}}" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Attempt" FontSize="14" Opacity=".68" />
                    <TextBlock Grid.Column="1" Text="{Binding Attempt}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Converter={StaticResource ActivityTimeLabel}}" FontSize="14" Opacity=".68" />
                    <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource ActivityTime}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28" Visibility="{Binding RetryOfTurnId, Converter={StaticResource NullVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Retry of" FontSize="14" Opacity=".68" />
                    <TextBlock Grid.Column="1" Text="{Binding RetryOfTurnId, Converter={StaticResource TurnIdShort}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding RetryOfTurnId}" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource Line}" Margin="0,13,0,11" />
                  <TextBlock Text="TOKENS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Opacity=".62" Margin="0,0,0,7" />
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Input" FontSize="14" Opacity=".68" AutomationProperties.Name="Input tokens" />
                    <TextBlock Grid.Column="1" Text="{Binding Usage, Converter={StaticResource UsageToken}, ConverterParameter=input}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Output" FontSize="14" Opacity=".68" AutomationProperties.Name="Output tokens" />
                    <TextBlock Grid.Column="1" Text="{Binding Usage, Converter={StaticResource UsageToken}, ConverterParameter=output}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Total" FontSize="14" Opacity=".68" AutomationProperties.Name="Total tokens" />
                    <TextBlock Grid.Column="1" Text="{Binding Usage, Converter={StaticResource UsageTotal}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource Line}" Margin="0,13,0,11" />
                  <TextBlock Text="TIMING" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Opacity=".62" Margin="0,0,0,7" />
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Queue wait" FontSize="14" Opacity=".68" AutomationProperties.Name="Queue wait" />
                    <TextBlock Grid.Column="1" Text="{Binding QueueWaitDuration, Converter={StaticResource TurnDuration}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="TTFT" FontSize="14" Opacity=".68" AutomationProperties.Name="TTFT: start to first non-empty text token" ToolTipService.ToolTip="Start to first non-empty text token" />
                    <TextBlock Grid.Column="1" Text="{Binding TimeToFirstToken, Converter={StaticResource TurnDuration}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Generation" FontSize="14" Opacity=".68" AutomationProperties.Name="Generation duration" />
                    <TextBlock Grid.Column="1" Text="{Binding GenerationDuration, Converter={StaticResource TurnDuration}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Height="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="End-to-end" FontSize="14" Opacity=".68" AutomationProperties.Name="End-to-end duration" />
                    <TextBlock Grid.Column="1" Text="{Binding EndToEndDuration, Converter={StaticResource TurnDuration}}" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <StackPanel Margin="0,16,0,0" Spacing="8" Visibility="{Binding Failure, Converter={StaticResource NullVisibility}}">
                    <InfoBar Title="Turn failed" Message="{Binding Failure.Message}" Severity="Error" IsClosable="False" IsOpen="True" />
                    <Grid Height="28">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock x:Uid="ActivityErrorCategoryLabel" Text="Error category" FontSize="14" Opacity=".68" AutomationProperties.Name="Error category" />
                      <TextBlock Grid.Column="1" Text="{Binding Failure, Converter={StaticResource FailureDetailText}, ConverterParameter=category}" TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="Error category value" ToolTipService.ToolTip="{Binding Failure, Converter={StaticResource FailureDetailText}, ConverterParameter=category}" />
                    </Grid>
                    <Grid Height="28">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock x:Uid="ActivityErrorCodeLabel" Text="Error code" FontSize="14" Opacity=".68" AutomationProperties.Name="Error code" />
                      <TextBlock Grid.Column="1" Text="{Binding Failure, Converter={StaticResource FailureDetailText}, ConverterParameter=code}" TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="Error code value" ToolTipService.ToolTip="{Binding Failure, Converter={StaticResource FailureDetailText}, ConverterParameter=code}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Visibility="{Binding Converter={StaticResource ActionAreaVisibility}}">
                    <Border Height="1" Background="{ThemeResource Line}" Margin="0,16,0,12" />
                    <Button Height="44" HorizontalAlignment="Stretch" Style="{StaticResource Action}" Click="StopClick" Tag="{Binding}" Visibility="{Binding Converter={StaticResource ActionVisibility}, ConverterParameter=stop}" AutomationProperties.Name="Stop turn">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="Stop" />
                      </StackPanel>
                    </Button>
                    <Button Height="44" HorizontalAlignment="Stretch" Style="{StaticResource Action}" Click="RetryClick" Tag="{Binding}" Visibility="{Binding Converter={StaticResource ActionVisibility}, ConverterParameter=retry}" AutomationProperties.Name="Retry turn">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Retry" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="SettingsHost"
          Grid.Row="2"
          Grid.Column="0"
          Grid.ColumnSpan="3"
          Canvas.ZIndex="20"
          Visibility="Collapsed">
      <local:SettingsPage x:Name="SettingsContent" />
    </Grid>
  </Grid>
</Window>
