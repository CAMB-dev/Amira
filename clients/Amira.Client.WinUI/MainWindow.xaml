<Window
    x:Class="Amira.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="Root" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Amira" FontSize="28" FontWeight="SemiBold"/>
        <ListView x:Name="BotsList" Grid.Row="1" ItemsSource="{Binding Bots}" SelectionChanged="BotsSelectionChanged"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="MessageBox" Width="500" PlaceholderText="Type your message..." Text="{Binding MessageText, Mode=TwoWay}" KeyDown="MessageKeyDown"/>
            <Button Content="Send" Click="SendClick" IsEnabled="{Binding CanSend}"/>
        </StackPanel>
    </Grid>
</Window>
