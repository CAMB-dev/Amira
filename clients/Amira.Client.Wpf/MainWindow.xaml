<Window x:Class="Amira.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Amira.Client.Wpf"
        xmlns:domain="clr-namespace:Amira.Domain;assembly=Amira.Domain"
        Title="Amira" Width="1280" Height="760" MinWidth="900" MinHeight="560">
  <Window.Resources><local:TurnActionEnabledConverter x:Key="TurnActionEnabled" /></Window.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <GroupBox Grid.Column="0" Margin="0,0,10,0" Header="Active Bots">
      <ListBox x:Name="BotsList" ItemsSource="{Binding Bots}" DisplayMemberPath="Profile.Name"
               SelectedItem="{Binding SelectedBot, Mode=OneWay}" SelectionChanged="BotsSelectionChanged"
               AutomationProperties.Name="Active Bots" />
    </GroupBox>
    <Grid Grid.Column="1" Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="150" /></Grid.RowDefinitions>
      <GroupBox Header="Direct chat">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Padding="8" Margin="4"><Border.Style><Style TargetType="Border">
              <Setter Property="Background" Value="AliceBlue" /><Setter Property="HorizontalAlignment" Value="Left" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Author}" Value="{x:Static domain:MessageAuthor.Human}"><Setter Property="Background" Value="Honeydew" /><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger>
                <DataTrigger Binding="{Binding Author}" Value="{x:Static domain:MessageAuthor.Bot}"><Setter Property="Background" Value="AliceBlue" /><Setter Property="HorizontalAlignment" Value="Left" /></DataTrigger>
              </Style.Triggers>
            </Style></Border.Style><StackPanel><TextBlock Text="{Binding Author}" FontWeight="Bold" /><TextBlock Text="{Binding Revision.Content}" TextWrapping="Wrap" /></StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
      </GroupBox>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding StreamingTurns}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="6" Margin="4"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBox x:Name="MessageInput" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Message" /><Button Grid.Row="1" Content="Send" Click="SendClick" IsEnabled="{Binding CanSend}" HorizontalAlignment="Right" MinWidth="90" Margin="0,6,0,0" AutomationProperties.Name="Send message" /></Grid>
    </Grid>
    <TabControl Grid.Column="2" AutomationProperties.Name="Configuration">
      <TabItem Header="Turns"><ListBox ItemsSource="{Binding Turns}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Status}" FontWeight="Bold" /><TextBlock Text="{Binding Model}" /><StackPanel Orientation="Horizontal"><Button Content="Stop" Click="StopClick" Tag="{Binding}" IsEnabled="{Binding Status, Converter={StaticResource TurnActionEnabled}, ConverterParameter=stop}" /><Button Content="Retry" Click="RetryClick" Tag="{Binding}" Margin="6,0,0,0" IsEnabled="{Binding Status, Converter={StaticResource TurnActionEnabled}, ConverterParameter=retry}" /></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
      <TabItem Header="Connections">
        <ScrollViewer><StackPanel Margin="8">
          <Button Content="New connection" Click="NewConnectionClick" />
          <ListBox x:Name="ConnectionsList" ItemsSource="{Binding Connections}" DisplayMemberPath="DisplayName" SelectionChanged="ConnectionSelectionChanged" Height="110" AutomationProperties.Name="Provider connections" />
          <TextBlock Text="Protocol" /><ComboBox x:Name="ProtocolBox" SelectedIndex="0" AutomationProperties.Name="Protocol"><ComboBoxItem Content="OpenAI Chat Compatible" Tag="OpenAIChatCompatible" /><ComboBoxItem Content="OpenAI Responses" Tag="OpenAIResponses" /><ComboBoxItem Content="Anthropic Messages" Tag="AnthropicMessages" /></ComboBox>
          <TextBlock Text="Display name" /><TextBox x:Name="ConnectionName" AutomationProperties.Name="Display name" />
          <TextBlock Text="Base URL" /><TextBox x:Name="ConnectionUrl" AutomationProperties.Name="Base URL" />
          <TextBlock Text="Default model" /><TextBox x:Name="ConnectionModel" AutomationProperties.Name="Default model" />
          <CheckBox x:Name="ConnectionEnabled" Content="Enabled" IsChecked="True" />
          <TextBlock Text="API key" /><PasswordBox x:Name="ApiKey" AutomationProperties.Name="API key" />
          <Button Content="Save connection" Click="SaveConnectionClick" Margin="0,8,0,0" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="New Bot"><ScrollViewer><StackPanel Margin="8"><TextBlock Text="Name" /><TextBox x:Name="BotName" AutomationProperties.Name="Bot name" /><TextBlock Text="Description" /><TextBox x:Name="BotDescription" AutomationProperties.Name="Bot description" /><TextBlock Text="Instructions" /><TextBox x:Name="BotInstructions" AcceptsReturn="True" Height="70" AutomationProperties.Name="Bot instructions" /><TextBlock Text="Connection" /><ComboBox x:Name="BotConnection" ItemsSource="{Binding Connections}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Provider connection" /><TextBlock Text="Model" /><TextBox x:Name="BotModel" AutomationProperties.Name="Bot model" /><TextBlock Text="Temperature (0-2)" /><TextBox x:Name="BotTemperature" Text="1" AutomationProperties.Name="Temperature" /><TextBlock Text="Max tokens" /><TextBox x:Name="BotMaxTokens" Text="1024" AutomationProperties.Name="Maximum tokens" /><Button Content="Create Bot" Click="CreateBotClick" Margin="0,8,0,0" /></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusText}" Foreground="DarkRed" Margin="0,8,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
