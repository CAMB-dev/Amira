{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amira theme",
  "description": "Named terminal theme. Missing tokens inherit the selected appearance's Amira defaults.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$",
      "allOf": [{ "pattern": "^\\S(?:.*\\S)?$" }],
      "description": "Theme name without surrounding whitespace or control characters."
    },
    "description": { "type": "string" },
    "dark": { "$ref": "#/$defs/palette" },
    "light": { "$ref": "#/$defs/palette" },
    "glyphs": { "$ref": "#/$defs/glyphs" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "fg": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "heading1": { "$ref": "#/$defs/hex" },
        "heading": { "$ref": "#/$defs/hex" },
        "path": { "$ref": "#/$defs/hex" },
        "command": { "$ref": "#/$defs/hex" },
        "fg2": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "dim": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hex" },
        "borderFocused": { "$ref": "#/$defs/hex" },
        "success": { "$ref": "#/$defs/hex" },
        "error": { "$ref": "#/$defs/hex" },
        "warning": { "$ref": "#/$defs/hex" },
        "thinking": { "$ref": "#/$defs/hex" },
        "userBg": { "$ref": "#/$defs/hex" },
        "codeBg": { "$ref": "#/$defs/hex" },
        "diffAddedBg": { "$ref": "#/$defs/hex" },
        "diffRemovedBg": { "$ref": "#/$defs/hex" },
        "diffAddedWordBg": { "$ref": "#/$defs/hex" },
        "diffRemovedWordBg": { "$ref": "#/$defs/hex" },
        "keyword": { "$ref": "#/$defs/hex" },
        "string": { "$ref": "#/$defs/hex" },
        "number": { "$ref": "#/$defs/hex" },
        "shimmer": { "$ref": "#/$defs/hex" },
        "shimmerEnd": { "$ref": "#/$defs/hex" }
      }
    },
    "glyph": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$",
      "description": "Plain single-line text. The host checks display width against the default glyph; warning may differ."
    },
    "glyphs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bullets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glyph" },
          "description": "One-cell bullets by nesting depth. Deeper levels repeat the last bullet."
        },
        "taskOpen": { "$ref": "#/$defs/glyph" },
        "taskDone": { "$ref": "#/$defs/glyph" },
        "quoteBar": { "$ref": "#/$defs/glyph" },
        "rule": { "$ref": "#/$defs/glyph" },
        "codeTop": { "$ref": "#/$defs/glyph" },
        "codeSide": { "$ref": "#/$defs/glyph" },
        "codeBottom": { "$ref": "#/$defs/glyph" },
        "tableColumn": { "$ref": "#/$defs/glyph" },
        "tableRule": { "$ref": "#/$defs/glyph" },
        "tableCross": { "$ref": "#/$defs/glyph" },
        "boxTopLeft": { "$ref": "#/$defs/glyph" },
        "boxTopRight": { "$ref": "#/$defs/glyph" },
        "boxBottomLeft": { "$ref": "#/$defs/glyph" },
        "boxBottomRight": { "$ref": "#/$defs/glyph" },
        "image": { "$ref": "#/$defs/glyph" },
        "user": { "$ref": "#/$defs/glyph" },
        "assistant": { "$ref": "#/$defs/glyph" },
        "toolDone": { "$ref": "#/$defs/glyph" },
        "toolRunning": { "$ref": "#/$defs/glyph" },
        "toolFailed": { "$ref": "#/$defs/glyph" },
        "toolInterrupted": { "$ref": "#/$defs/glyph" },
        "toolBlocked": { "$ref": "#/$defs/glyph" },
        "toolUnknown": { "$ref": "#/$defs/glyph" },
        "toolInvalid": { "$ref": "#/$defs/glyph" },
        "result": { "$ref": "#/$defs/glyph" },
        "treeBranch": { "$ref": "#/$defs/glyph" },
        "output": { "$ref": "#/$defs/glyph" },
        "subagent": { "$ref": "#/$defs/glyph" },
        "subagentDone": { "$ref": "#/$defs/glyph" },
        "subagentFailed": { "$ref": "#/$defs/glyph" },
        "subagentAborted": { "$ref": "#/$defs/glyph" },
        "thought": { "$ref": "#/$defs/glyph" },
        "question": { "$ref": "#/$defs/glyph" },
        "dialogBar": { "$ref": "#/$defs/glyph" },
        "choice": { "$ref": "#/$defs/glyph" },
        "checked": { "$ref": "#/$defs/glyph" },
        "unchecked": { "$ref": "#/$defs/glyph" },
        "info": { "$ref": "#/$defs/glyph" },
        "success": { "$ref": "#/$defs/glyph" },
        "warning": { "$ref": "#/$defs/glyph" },
        "error": { "$ref": "#/$defs/glyph" },
        "interrupted": { "$ref": "#/$defs/glyph" },
        "more": { "$ref": "#/$defs/glyph" },
        "pointer": { "$ref": "#/$defs/glyph" },
        "search": { "$ref": "#/$defs/glyph" },
        "searchPrompt": { "$ref": "#/$defs/glyph" },
        "working": { "$ref": "#/$defs/glyph" },
        "branch": { "$ref": "#/$defs/glyph" },
        "separator": { "$ref": "#/$defs/glyph" }
      }
    }
  }
}
